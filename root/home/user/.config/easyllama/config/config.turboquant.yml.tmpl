macros:
  qwen3_chat_target_hf: unsloth/Qwen3.6-27B-GGUF:UD-Q5_K_XL
  pi_emb_hf_model: Qwen/Qwen3-Embedding-8B-GGUF:Q5_K_M
models:
  qwen3-chat:
    name: Pi Qwen3 Chat 27B Turboquant
    description: Primary chat/completions model with turboquant KV cache enabled
    concurrencyLimit: 4
    filters:
      setParams:
        reasoning: 'off'
        chat_template_kwargs:
          tokenize: false
          add_generation_prompt: true
          enable_thinking: false
          preserve_thinking: false
    cmd: '${server_bin}
      server
      turboquant
      --bin /app/bin/llama-server-turboquant
      --port ${PORT}
      -hf ${qwen3_chat_target_hf}
      --ctx-size 131072
      --n-predict -1
      --temp 0.7
      --top-k 20
      --top-p 0.80
      --min-p 0.0
      --sampler-seq edskypmxt
      --repeat-last-n 512
      --repeat-penalty 1.0
      --presence-penalty 1.5
      --frequency-penalty 0.0
      --dry-multiplier 0.0
      --dry-base 1.75
      --dry-allowed-length 2
      --dry-penalty-last-n 512
      --batch-size 2048
      --ubatch-size 1024
      --parallel 1
      --fit on
      --flash-attn on
      --cache-type-k turbo4
      --cache-type-v turbo3
      --no-webui
      --no-mmap
      --poll 1
      --chat-template-kwargs {\"tokenize\":false,\"add_generation_prompt\":true,\"enable_thinking\":false,\"preserve_thinking\":false}
      --reasoning off
      '
  qwen3-embeddings:
    name: Pi Qwen3 Embeddings 8B
    description: Dense embedding model for vector search, RAG, similarity
    concurrencyLimit: 4
    cmd: '${server_bin}
      server
      turboquant
      --bin /app/bin/llama-server-turboquant
      --port ${PORT}
      -hf ${pi_emb_hf_model}
      --ctx-size 131072
      --batch-size 2048
      --ubatch-size 1024
      --parallel 1
      --flash-attn on
      --cache-type-k f16
      --cache-type-v f16
      --kv-unified
      --no-mmap
      --embedding
      --no-warmup
      '
