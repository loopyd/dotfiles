
[env]
TERM = "alacritty"
WINIT_X11_SCALE_FACTOR = "1"

[window]
dynamic_padding = true
dynamic_title = true
decorations = "full"
title = "Alacritty"
opacity = 1.0
decorations_theme_variant = "Dark"
resize_increments = true

[window.dimensions]
columns = 100
lines = 30

[window.class]
instance = "Alacritty"
general = "Alacritty"

[scrolling]
history = 10000
multiplier = 3

[font]
size = 16.0

[font.normal]
family = "DepartureMono Nerd Font"
style = "Regular"

[font.bold]
family = "DepartureMono Nerd Font"
style = "Bold"

[font.italic]
family = "DepartureMono Nerd Font"
style = "Italic"

[font.bold_italic]
family = "DepartureMono Nerd Font"
style = "Bold Italic"

[selection]
semantic_escape_chars = ",│`|:\"' ()[]{}<>\t"
save_to_clipboard = false

[cursor]
vi_mode_style = "None"
unfocused_hollow = true

[cursor.style]
shape = "Block"
blinking = "On"

[mouse]
hide_when_typing = true

[[mouse.bindings]]
mouse = "Middle"
action = "PasteSelection"

[keyboard]

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY@@"
action = "Paste"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_2@@"
action = "Copy"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_3@@"
mods = "Control"
action = "ClearLogNotice"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_3@@"
mods = "Control"
mode = "~Vi"
chars = "\f"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_4@@"
mods = "Shift"
mode = "~Alt"
action = "ScrollPageUp"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_5@@"
mods = "Shift"
mode = "~Alt"
action = "Scroll@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_5@@"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_6@@"
mods = "Shift"
mode = "~Alt"
action = "ScrollToTop"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_7@@"
mods = "Shift"
mode = "~Alt"
action = "ScrollToBottom"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_8@@"
mods = "Control|Shift"
action = "Paste"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_9@@"
mods = "Control|Shift"
action = "Copy"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_10@@"
mods = "Control|Shift"
action = "SearchForward"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_11@@"
mods = "Control|Shift"
action = "SearchBackward"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_9@@"
mods = "Control|Shift"
mode = "Vi"
action = "ClearSelection"

[[keyboard.bindings]]
key = "@@DOTFILES:SECRET_CONFIG_ALACRITTY_ALACRITTY_TOML_KEY_12@@"
mods = "Control"
action = "ResetFontSize"

[hints]

[[hints.enabled]]
command = "xdg-open"
hyperlinks = true
post_processing = true
persist = false
mouse.enabled = true
mouse.mods = "Control"
binding = { key = "U", mods = "Control|Shift" }
regex = '(ipfs:|ipns:|magnet:|mailto:|gemini://|gopher://|https?://|news:|file:|git://|ssh:|ftp://)[^\u0000-\u001F\u007F-\u009F<>"\s{-}\^⟨⟩`]+'

[general]
live_config_reload = true
import = ["~/.config/alacritty/themes/themes/smoky-inferno.toml"]

[terminal]
osc52 = "copypaste"
