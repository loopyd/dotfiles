services:
  database:
    image: ghcr.io/tensorchord/vchord-postgres@sha256:700ff05ebdc7e4afd4dd8442e0684293046c3833677fec326550000a04cf8a91
    container_name: hindsight-db
    hostname: hindsight-db
    user: "@@DOTFILES:UID@@:@@DOTFILES:GID@@"
    restart: "no"
    env_file:
      - ./postgres.env
    volumes:
      - @@DOTFILES:HOME@@/.local/share/hindsight/postgres:/var/lib/postgresql
      - @@DOTFILES:HOME@@/.config/hindsight/initdb:/docker-entrypoint-initdb.d:ro
    network_mode: host
    command: ["postgres", "-c", "shared_preload_libraries=vchord,vector", "-c", "listen_addresses=127.0.0.1"]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -q -U postgres -d hindsight"]
      interval: 5s
      timeout: 3s
      retries: 24
      start_period: 10s
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m,uid=@@DOTFILES:UID@@,gid=@@DOTFILES:GID@@,mode=0700
      - /var/run/postgresql:rw,noexec,nosuid,size=16m,uid=@@DOTFILES:UID@@,gid=@@DOTFILES:GID@@,mode=0700
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    shm_size: 4g
    mem_limit: 2g
    cpus: 2
    pids_limit: 256
    stop_grace_period: 60s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"

  app:
    image: "@@DOTFILES:HINDSIGHT_IMAGE@@"
    container_name: hindsight
    hostname: hindsight-local
    user: "@@DOTFILES:UID@@:@@DOTFILES:GID@@"
    restart: "no"
    depends_on:
      database:
        condition: service_healthy
    env_file:
      - ./server.env
    volumes:
      - @@DOTFILES:HOME@@/.local/share/hindsight/cache:/home/hindsight/.cache
    network_mode: host
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=256m,uid=@@DOTFILES:UID@@,gid=@@DOTFILES:GID@@,mode=0700
      - /app/control-plane/.next/cache:rw,noexec,nosuid,size=64m,uid=@@DOTFILES:UID@@,gid=@@DOTFILES:GID@@,mode=0700
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    shm_size: 4g
    mem_limit: 6g
    memswap_limit: 8g
    cpus: 8
    pids_limit: 512
    stop_grace_period: 60s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
