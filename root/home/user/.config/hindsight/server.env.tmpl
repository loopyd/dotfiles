HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_CP_HOSTNAME=localhost
HINDSIGHT_CP_PORT=9999
HINDSIGHT_API_LLM_PROVIDER=openai-responses
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:8080/v1
HINDSIGHT_API_LLM_MODEL=bonsai-chat
HINDSIGHT_API_REFLECT_LLM_MODEL=bonsai-chat
HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=bonsai-chat
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=32768
# Retain granularity: one operation must complete inside Hindsight 3600s wall clock.
# Measured: with 32 chunks per batch and ~17 facts per 3000-char chunk, one op needed
# ~640k output tokens (~2.7h at 66 tok/s) and hit the wall limit, so completed barely moved.
HINDSIGHT_API_RETAIN_WALL_TIMEOUT=10800
HINDSIGHT_API_RETAIN_CHUNK_SIZE=1500
HINDSIGHT_API_RETAIN_CHUNK_BATCH_SIZE=1
# Sub-batch size caps how much work one operation owns. At the 10000-char default a
# document became ~27 chunk calls, so a single op consumed ~30 min of generation and
# completions stayed near zero. 4000 chars keeps an op to a few calls so it finishes.
HINDSIGHT_API_RETAIN_BATCH_TOKENS=1500
# Reflect at high effort blew its 1000s wall clock; give it room.
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=2000
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=qwen3-embeddings
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024
HINDSIGHT_API_RERANKER_PROVIDER=cohere
HINDSIGHT_API_RERANKER_COHERE_BASE_URL=http://127.0.0.1:8080/v1/rerank
HINDSIGHT_API_RERANKER_COHERE_MODEL=qwen3-reranker
HINDSIGHT_API_RERANKER_COHERE_API_KEY=@@DOTFILES:SECRET_EASYLLAMA_CONFIG_EASYLLAMA_CONFIG_JSON_API_KEY@@
HINDSIGHT_API_RERANKER_COHERE_TIMEOUT=120
HINDSIGHT_API_RERANKER_FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
HINDSIGHT_API_MODEL_INIT_TIMEOUT=300
HINDSIGHT_WAIT_FOR_DEPS=false
HINDSIGHT_API_WORKER_ID=hindsight-local
HINDSIGHT_API_LOG_LEVEL=info
HINDSIGHT_API_LLM_API_KEY=@@DOTFILES:SECRET_EASYLLAMA_CONFIG_EASYLLAMA_CONFIG_JSON_API_KEY@@
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=@@DOTFILES:SECRET_EASYLLAMA_CONFIG_EASYLLAMA_CONFIG_JSON_API_KEY@@
HINDSIGHT_API_DATABASE_URL=@@DOTFILES:SECRET_CONFIG_HINDSIGHT_SERVER_ENV_URL@@
HINDSIGHT_API_VECTOR_EXTENSION=vchord
HINDSIGHT_API_RERANKER_FLASHRANK_CACHE_DIR=/home/hindsight/.cache/flashrank
TIKTOKEN_CACHE_DIR=/home/hindsight/.cache/tiktoken
HF_HOME=/home/hindsight/.cache/huggingface
NODE_OPTIONS=--dns-result-order=ipv4first
HINDSIGHT_API_WORKER_MAX_SLOTS=6
HINDSIGHT_API_WORKER_CONSOLIDATION_RESERVED_SLOTS=1
HINDSIGHT_API_WORKER_RETAIN_RESERVED_SLOTS=2
HINDSIGHT_API_WORKER_REFRESH_MENTAL_MODEL_RESERVED_SLOTS=1
# Slot budget for the single co-resident bonsai-chat route (--parallel 6,
# --kv-unified). The global cap and the per-op caps compose, and a scope can
# never exceed its own cap, so the caps below partition the LLM slots and stop
# the 26k-deep retain queue from monopolising them. Measured 2026-09-22 (commit
# 2d04e5f): 8 concurrent calls collapsed per-slot prefill to 62-176 tok/s and
# wedged every op on its wall-clock timeout; aggregate decode saturates at
# roughly 180-210 tok/s once three or more streams are active. 4 global is the
# measured trade of ~+20% aggregate for ~-10% per-stream latency against 3, and
# stays well clear of the collapse point. Every scope keeps a guaranteed slot:
#   retain 2 + consolidation 1 + reflect 1 = global 4.
HINDSIGHT_API_LLM_MAX_CONCURRENT=4
HINDSIGHT_API_LLM_STRICT_SCHEMA=false
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=2
# One /v1/embeddings request must stay inside the llama.cpp slot. The bonsai
# qwen3-embeddings route is --ctx-size 32768 --parallel 4 and now runs
# --kv-unified (config/config.bonsai.yml, applied 2026-09-25), so one request
# may use the full 32768. 4 keeps a batch under 4 x RETAIN_BATCH_TOKENS (1500)
# = 6000 tokens and is the value proven while the route still had 8192-token
# slots; it can be raised now that unified KV is live.
HINDSIGHT_API_EMBEDDINGS_OPENAI_BATCH_SIZE=4
HINDSIGHT_API_EMBEDDINGS_MAX_CONCURRENT_REQUESTS=2
HINDSIGHT_API_DB_POOL_MIN_SIZE=4
HINDSIGHT_API_DB_POOL_MAX_SIZE=40
HINDSIGHT_API_RETAIN_MAX_CONCURRENT=8
HINDSIGHT_API_RECALL_MAX_CONCURRENT=8
HINDSIGHT_API_RERANKER_FLASHRANK_BATCH_SIZE=8
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
HINDSIGHT_API_LLM_TIMEOUT=600
HINDSIGHT_API_LLM_INITIAL_BACKOFF=40
HINDSIGHT_API_LLM_MAX_BACKOFF=60
HINDSIGHT_API_RETAIN_LLM_REASONING_EFFORT=low
# Reasoning level is a caller decision, set here per scope: the EasyLlama bonsai
# profile pins no level, so these values are what reaches the model. Retain stays
# at `low` for bulk extraction (thinking is charged against the same output
# allowance as the answer, and MAXIMUM-VERBOSITY extraction needs room for the
# JSON); reflect runs at `high` because synthesis is where deeper thinking pays.
# level=low|medium|high|xhigh|minimal, sent as the request's reasoning_effort.
# Consolidation also runs thinking-free, like retain: it must return structured
# JSON, and with thinking on it emitted a ~47 KB reply that arrived truncated
# ("Unterminated string") and never committed a batch.
HINDSIGHT_API_RETAIN_LLM_EXTRA_BODY={"reasoning_effort": "low", "chat_template_kwargs": {"enable_thinking": false}}
HINDSIGHT_API_REFLECT_LLM_EXTRA_BODY={"reasoning_effort": "high", "reasoning_budget": 4096}
HINDSIGHT_API_CONSOLIDATION_LLM_EXTRA_BODY={"reasoning_effort": "low", "chat_template_kwargs": {"enable_thinking": false}}
HINDSIGHT_API_LLM_REASONING_EFFORT=low
HINDSIGHT_API_CONSOLIDATION_LLM_REASONING_EFFORT=low
HINDSIGHT_API_REFLECT_LLM_REASONING_EFFORT=low
# Bound reflect/mental-model synthesis: this variable is uncapped by default, so on
# a self-hosted reasoning model a synthesis call can run until the request timeout
# and wedge a worker slot. keep thinking volume low for the same reason.
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=32768
HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS=250000
HINDSIGHT_API_CONSOLIDATION_LLM_BATCH_SIZE=8
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_REFLECT_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_ENABLE_OBSERVATIONS=true
# Auto-consolidation was disabled on 2026-09-22 because reflect failed here with
# ReflectToolCallError (no usable tool call from qwen3-chat) and would re-queue
# endlessly. That cause is gone: the stack now serves bonsai-chat (PrismML
# Ternary Bonsai 2 27B, native tool calls via qwen3.8.jinja), and over the 48h to
# 2026-09-25 reflect logged 0 ReflectToolCallError across 288 reflect / mental-
# model runs and 140 applied delta refreshes. Re-enable it, gated by the per-op
# caps above (consolidation=1, reflect=1, global=4) so it cannot starve retain or
# the model. Per-bank config also carries enable_auto_consolidation; both must
# agree, because the bank value overrides this default.
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=true
HINDSIGHT_API_MENTAL_MODEL_MIN_REFRESH_INTERVAL_SECONDS=3600
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=@@DOTFILES:SECRET_HINDSIGHT_API_KEY@@
HINDSIGHT_API_TENANT_MCP_AUTH_DISABLED=false
HINDSIGHT_API_MCP_AUTH_TOKEN=@@DOTFILES:SECRET_HINDSIGHT_API_KEY@@
HINDSIGHT_CP_DATAPLANE_API_URL=http://127.0.0.1:8888
HINDSIGHT_CP_DATAPLANE_API_KEY=@@DOTFILES:SECRET_HINDSIGHT_API_KEY@@
HINDSIGHT_CP_ACCESS_KEY=@@DOTFILES:SECRET_HINDSIGHT_DASHBOARD_ACCESS_KEY@@
