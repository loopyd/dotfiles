[
  {
    "plugin_id": "drper-herdr",
    "name": "DRPer Herdr Bridge",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Forwards Herdr lifecycle context to the local DRPer API.",
    "manifest_path": "/mnt/PROJECTS/repos/drper/plugins/herdr-plugin/herdr-plugin.toml",
    "plugin_root": "/mnt/PROJECTS/repos/drper/plugins/herdr-plugin",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "startup": [
      {
        "command": [
          "bun",
          "run",
          "src/event.ts"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "bun",
          "run",
          "src/event.ts"
        ]
      },
      {
        "on": "pane.agent_status_changed",
        "command": [
          "bun",
          "run",
          "src/event.ts"
        ]
      },
      {
        "on": "workspace.closed",
        "command": [
          "bun",
          "run",
          "src/event.ts"
        ]
      },
      {
        "on": "workspace.created",
        "command": [
          "bun",
          "run",
          "src/event.ts"
        ]
      },
      {
        "on": "workspace.updated",
        "command": [
          "bun",
          "run",
          "src/event.ts"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
