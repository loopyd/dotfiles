services:
  router:
    image: 9router:local
    container_name: 9router
    network_mode: host
    restart: "no"
    user: "@@DOTFILES:UID@@:@@DOTFILES:GID@@"
    entrypoint: ["node", "custom-server.js"]
    init: true
    cpus: 2.0
    shm_size: 4g
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    env_file: ["runtime.env"]
    environment:
      NODE_ENV: production
      NODE_OPTIONS: "--dns-result-order=ipv4first --max-old-space-size=6144"
      NEXT_TELEMETRY_DISABLED: "1"
      PORT: "20128"
      HOSTNAME: "127.0.0.1"
      HOME: /home/node
      DATA_DIR: /app/data
    volumes:
      - "@@DOTFILES:HOME@@/.9router:/app/data"
      - "@@DOTFILES:HOME@@/.9router:/home/node/.9router"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:20128/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 20s
    logging:
      driver: json-file
      options: {max-size: "10m", max-file: "3"}
