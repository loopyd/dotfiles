[Unit]
Description=EasyLlama native Qwen stack (private network + LMCache)
Before=hindsight.service

[Service]
Type=simple
Environment=EASYLLAMA_ROOT=@@DOTFILES:EASYLLAMA_ROOT@@
ExecStartPre=/usr/bin/python3 %h/.local/lib/dotfiles/readiness.py wait docker
ExecStart=/usr/bin/python3 %h/.local/lib/dotfiles/easyllama.py latch
ExecStop=-/usr/bin/python3 %h/.local/lib/dotfiles/easyllama.py stop
SuccessExitStatus=130 137 143
Restart=on-failure
RestartSec=15
TimeoutStartSec=2100
TimeoutStopSec=300
UMask=0077

[Install]
WantedBy=default.target
