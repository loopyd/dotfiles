[Unit]
Description=9router gateway (Docker Compose)
After=tailscale.service
Wants=tailscale.service
PartOf=tailscale.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test -s %h/.9router/db/data.sqlite
ExecStartPre=/usr/bin/python3 %h/.local/lib/dotfiles/readiness.py wait router
ExecStartPre=/usr/bin/python3 %h/.local/lib/dotfiles/router.py preflight
ExecStartPre=/usr/bin/python3 %h/.local/lib/dotfiles/router.py stage
ExecStart=/usr/bin/docker start --attach 9router
ExecStop=-/usr/bin/docker stop --time 60 9router
SuccessExitStatus=130 137 143
Restart=always
RestartSec=15
TimeoutStartSec=210
TimeoutStopSec=90

[Install]
WantedBy=default.target
