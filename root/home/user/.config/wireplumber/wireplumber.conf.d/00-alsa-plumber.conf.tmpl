        ["api.acp.auto-profile"] = false
        ["api.acp.auto-port"] = false
        # ["device.nick"] = "My Device"
      }
    }

    {
      matches = [
        { ["node.name"] = "alsa_input.*" },
        { ["node.name"] = "alsa_output.*" }
      ]

      apply_properties = {
        # (empty; your Lua block only has commented examples)
      }
    }
  ]
