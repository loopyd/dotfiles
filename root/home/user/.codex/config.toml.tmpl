
model = "gpt-6.1-sol"
model_reasoning_effort = "xhigh"
model_auto_compact_token_limit = 220000
model_auto_compact_token_limit_scope = "total"
tool_output_token_limit = 8000
experimental_compact_prompt_file = "@@DOTFILES:HOME@@/.codex/context-gardener-compact-prompt.md"

approval_policy = "on-request"
approvals_reviewer = "auto_review"
developer_instructions = """
Approval-loop discipline: after an auto-review denial, do not repeat the request
or pursue the same outcome through wrappers, alternate tools, or broader permissions.
Continue only with a materially safer, policy-compliant alternative. If none exists,
stop and report the denied action, reason, and exact user authorization needed.
If that safer alternative is also denied, stop rather than generate more variants.
A reviewer timeout is not a denial: retry the identical request at most once;
if it times out again, stop and report the infrastructure blocker.
Do not weaken sandbox settings, approval policies, or command rules to make progress.
"""
sandbox_mode = "workspace-write"

service_tier = "fast"

[features]
hooks = true
context_management.experimental_mode = true

[projects."/mnt/PROJECTS/repos/rebof3-simple"]
trust_level = "trusted"

[tui.model_availability_nux]
gpt-6-astra = 1

[mcp_servers."sqlitecloud-mcp-server"]
command = "npx"
args = ["-y", "@sqlitecloud/mcp-server", "--connectionString", "sqlitecloud://cb1v6252dz.g2.sqlite.cloud:8860/inventory?apikey=@@DOTFILES:SECRET_CODEX_SQLITECLOUD_API_KEY@@"]

[mcp_servers."github-mcp-server"]
command = "docker"
args = ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"]
[mcp_servers."github-mcp-server".env]
"GITHUB_PERSONAL_ACCESS_TOKEN" = "@@DOTFILES:SECRET_CODEX_CONFIG_TOML_CREDENTIAL@@"

