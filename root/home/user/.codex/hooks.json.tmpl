{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"@@DOTFILES:HOME@@/.hindsight/coding-agents/dist/codex-sessionstart-hook.js\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '@@DOTFILES:HOME@@/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"@@DOTFILES:HOME@@/.hindsight/coding-agents/dist/codex-stop-hook.js\"",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"@@DOTFILES:HOME@@/.local/lib/dotfiles/hindsight-hook.mjs\"",
            "timeout": 210,
            "type": "command"
          }
        ]
      }
    ]
  }
}
