  "followUpMode": "one-at-a-time",
  "quietStartup": true,
  "theme": "smoky-inferno",
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": true
  },
  "doubleEscapeAction": "tree",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 24000
  },
  "branchSummary": {
    "reserveTokens": 32768,
    "skipPrompt": false
  },
  "packages": [
    "npm:context-mode",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-intercom",
    "npm:pi-web-access",
    "npm:@sting8k/pi-vcc@0.4.0",
    "npm:pi-semantic-edit",
    "npm:pi-goal-x"
  ],
  "agentScope": "both",
  "confirmProjectAgents": true,
  "subagents": {
    "agentOverrides": {
      "scout": {
        "thinking": "xhigh"
      },
      "worker": {
        "thinking": "medium"
      },
      "reviewer": {
        "thinking": "high"
      },
      "context-builder": {
        "model": "ninerouter/gpt-combo",
