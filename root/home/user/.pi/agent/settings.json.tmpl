{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "ninerouter",
  "defaultModel": "qwen-combo",
  "defaultThinkingLevel": "xhigh",
  "thinkingBudgets": {
    "minimal": 512,
    "low": 1024,
    "medium": 1024,
    "high": 512,
    "xhigh": 512
  },
  "httpIdleTimeoutMs": 300000,
  "steeringMode": "all",
  "hideThinkingBlock": true,
  "enableInstallTelemetry": false,
  "treeFilterMode": "all",
