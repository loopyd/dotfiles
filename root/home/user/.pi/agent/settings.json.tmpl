      },
      "researcher": {
        "thinking": "xhigh"
      },
      "delegate": {
        "thinking": "xhigh"
      },
      "oracle": {
        "thinking": "low"
      }
    }
  },
  "showHardwareCursor": true,
  "tuiMode": "regular",
  "collapseChangelog": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "extensions": [
    "/home/koija/.hindsight/coding-agents/dist/pi.js"
  ]
