    const record={...receipt,request_sha256:sha(raw),workflow_request_sha256:request.workflow_request_sha256??sha(raw),capture_request_path:requestPath};const temp=journal+'.complete';await fs.writeFile(temp,JSON.stringify(record)+'\n',{flag:'wx',mode:0o600});await fs.rename(temp,journal);return receipt;
