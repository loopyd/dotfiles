const fs=require('node:fs/promises');const path=require('node:path');const {main}=require('./herdr_client.cjs');const {fail,sha,boundedFile,cli}=require('./json_io.cjs');
async function safePath(file){if(!path.isAbsolute(file||'')||file.split('/').includes('..'))fail('invalid_path');for(let p=file;;p=path.dirname(p)){try{if((await fs.lstat(p)).isSymbolicLink())fail('symlink_rejected')}catch(e){if(e.code!=='ENOENT')throw e}if(p===path.dirname(p))break}}
async function captured(input){
  const deadline=Date.now()+5000;let record;
  do{try{record=JSON.parse(await boundedFile(input.capture_path+'.capture-run',65536));if(record.completed===true)break}catch(error){if(error.code!=='ENOENT')throw error}await new Promise(resolve=>setTimeout(resolve,25))}while(Date.now()<deadline);
  if(!record||record.completed!==true||record.status!=='verified'||record.exit_code!==0||record.signal!==null||record.timed_out!==false||record.truncated!==false||record.shutdown_bound!==false||record.output_path!==input.capture_path||record.workflow_request_sha256!==input.sha256||!Number.isInteger(record.size_bytes)||!/^[0-9a-f]{64}$/.test(record.sha256))fail('capture_completion_unverified');
  if(!path.isAbsolute(record.capture_request_path||'')||path.dirname(record.capture_request_path)!==path.dirname(input.capture_path))fail('capture_identity_mismatch');await safePath(record.capture_request_path);
  const config=await boundedFile(record.capture_request_path,1048576);if(sha(config)!==record.request_sha256)fail('capture_identity_mismatch');const request=JSON.parse(config);if(request.output_path!==input.capture_path||request.workflow_request_sha256!==input.sha256)fail('capture_identity_mismatch');
  const bytes=await boundedFile(input.capture_path,3*1024**2,record.size_bytes);if(sha(bytes)!==record.sha256)fail('capture_integrity_mismatch');return{status:'verified',output_path:input.capture_path,size_bytes:bytes.length,sha256:record.sha256};
}
async function run(input){
  if(!input||typeof input!=='object'||!Number.isInteger(input.size_bytes)||input.size_bytes<1||input.size_bytes>1048576||!/^[0-9a-f]{64}$/.test(input.sha256))fail('invalid_file_request');
