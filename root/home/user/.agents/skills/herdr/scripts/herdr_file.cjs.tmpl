  try{reservation=await fs.open(journal,'wx',0o600);await reservation.writeFile(JSON.stringify({...binding,status:'started'})+'\n');await reservation.sync();await reservation.close()}
  catch(error){if(error.code!=='EEXIST')throw error;const previous=JSON.parse(await boundedFile(journal,65536));if(previous.request_sha256!==input.sha256||previous.output_path!==input.output_path||previous.capture_path!==binding.capture_path)fail('run_identity_conflict');if(!['operation_complete','complete'].includes(previous.status))fail('previous_operation_uncertain');const saved=await boundedFile(input.output_path,3*1024**2,previous.receipt_size_bytes);if(sha(saved)!==previous.receipt_sha256||JSON.parse(saved).status!=='verified')fail('previous_receipt_integrity_mismatch');const receipt=input.capture_path?await captured(input):{status:'verified',output_path:input.output_path,size_bytes:saved.length,sha256:sha(saved)};if(previous.status==='complete'&&(previous.output_sha256!==receipt.sha256||previous.output_size_bytes!==receipt.size_bytes))fail('previous_output_integrity_mismatch');await writeJournal({status:'complete',receipt_sha256:sha(saved),receipt_size_bytes:saved.length,output_sha256:receipt.sha256,output_size_bytes:receipt.size_bytes});return{...receipt,reused:true}}
  let output;try{output=await fs.open(input.output_path,'wx',0o600)}catch(error){await writeJournal({status:'rejected',reason:'output_collision'});if(error.code==='EEXIST')fail('output_collision');throw error}
  let result;
